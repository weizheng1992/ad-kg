# ════════════════════════════════════════════════════════════════
# AdKG 环境模板 —— cp .env.example .env 后填写；.env 永不入库
# 约定见 README：§五 运行形态 · §9.1 认证 · §12.4 bindings
# ════════════════════════════════════════════════════════════════

# ── 存储：PostgreSQL 18（docker compose 共用本文件）─────────────
POSTGRES_USER=adkg
POSTGRES_PASSWORD=change-me-pg
POSTGRES_DB=adkg
POSTGRES_PORT=5433
# 应用读写账号与只读账号由 scripts/init_db.py 创建（adkg_rw / adkg_ro）
ADKG_PG_DSN=postgresql://adkg_rw:change-me-rw@127.0.0.1:5433/adkg
ADKG_PG_RO_DSN=postgresql://adkg_ro:change-me-ro@127.0.0.1:5433/adkg

# ── 存储：Neo4j 2025.09 LTS ─────────────────────────────────────
NEO4J_AUTH=neo4j/change-me-neo4j
ADKG_NEO4J_URI=bolt://127.0.0.1:7687
ADKG_NEO4J_USER=neo4j
ADKG_NEO4J_PASSWORD=change-me-neo4j

# ── LLM（OpenAI 兼容；抽取 / 路由 / Text2SQL / judge 共用一个适配层）──
ADKG_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ADKG_LLM_API_KEY=sk-change-me
ADKG_LLM_MODEL=glm-4.6                    # 按账号开通型号填写

# ── 嵌入（OpenAI 兼容 API：硅基流动 / 百炼；1024 维、cosine、HNSW）──
ADKG_EMBED_BASE_URL=https://api.siliconflow.cn/v1
ADKG_EMBED_API_KEY=sk-change-me
ADKG_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
ADKG_EMBED_DIM=1024

# ── 重排（可选，仅 vector 路精排；留空即关闭）───────────────────
ADKG_RERANK_BASE_URL=
ADKG_RERANK_API_KEY=
ADKG_RERANK_MODEL=

# ── 认证：service token（每 role 一枚；token→role/Person 映射见  #
#    permissions.yaml#bindings；生产换强随机值并入密管）           #
#    本地开发：ADKG_DEV_AUTH=off 时可在 body 传 role（仅限本地）   #
ADKG_DEV_AUTH=off
ADKG_TOKEN_AE=change-me-ae
ADKG_TOKEN_OPTIMIZER=change-me-optimizer
ADKG_TOKEN_CREATIVE=change-me-creative
ADKG_TOKEN_CLIENT=change-me-client
ADKG_TOKEN_FINANCE=change-me-finance
ADKG_TOKEN_MANAGEMENT=change-me-management
ADKG_TOKEN_ADMIN=change-me-admin

# ── 飞书（Phase 2b 云文档按 revision 增量；开放平台"自建应用"）────
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 路径（相对仓库根，一般不用改）────────────────────────────────
ADKG_RAW_DIR=data/raw
ADKG_SEED_DIR=data/seed
